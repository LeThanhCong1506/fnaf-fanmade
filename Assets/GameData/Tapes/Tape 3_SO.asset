  recording: {fileID: 8300000, guid: 7308f65b585f23641bc0c6e646b131e5, type: 3}
  subtitles:
  - text: I saw something. In the mirror. When I was washing my hands... I saw the
      Bear.
    duration: 7
  - text: Standing right behind me.
    duration: 1.5
  - text: But when I turned around... nothing. Just an empty stall.
    duration: 5
  - text: I... I must be tired. The flickering lights are messing with my head.
    duration: 5.5
  - text: I need to check the animatronics. Make sure they are actually on their
      stage.
    duration: 5.5
  - text: "I\u2019m going to Backstage storage. I think I left my flashlight there
      anyway."
    duration: 5.5
